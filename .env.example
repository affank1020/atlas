DATABASE_URL=postgresql://atlas:atlas@127.0.0.1:5432/atlas
ATLAS_HOST=127.0.0.1
ATLAS_PORT=3000
ATLAS_MEDIA_DIR=./data/media

# Optional Ask Portfolio / Contentful integration. The Delivery token only needs
# read access to published content in this space/environment.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_ACCESS_TOKEN=
CONTENTFUL_WEBHOOK_SIGNING_SECRET=
CONTENTFUL_WEBHOOK_TTL_SECONDS=60

# Local workspaces are disabled until at least one existing directory is allowed.
# Use narrowly scoped absolute paths, separated by commas. Files remain on disk.
ATLAS_WORKSPACE_ROOTS=
# To register this checkout for development tasks, add its absolute path above.
# Optional absolute path when the service PATH does not include Unity CLI.
ATLAS_UNITY_CLI=
# Exact discovered Editor command names reviewed by the local operator; empty denies invocation.
ATLAS_UNITY_ALLOWED_COMMANDS=
# Trusted browser origins for workspace HTTP and MCP (native clients omit Origin).
ATLAS_WORKSPACE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Display name used when the persisted Local Node is first registered (defaults to hostname).
ATLAS_NODE_NAME=
