# Copy to .env.node. Keep this file on the machine that owns the workspaces.
ATLAS_NODE_ID=00000000-0000-4000-8000-000000000001
ATLAS_NODE_NAME=My development Node
ATLAS_NODE_PLATFORM=macos
ATLAS_SERVER_URL=ws://127.0.0.1:3000/node/connect
# Enrol through POST /node/enrol, then store the returned credential privately (0600).
ATLAS_NODE_CREDENTIAL=
ATLAS_WORKSPACE_ROOTS=/absolute/path/to/approved/project
# Opt in to Unity only on hosts with the Editor/Pipeline available.
ATLAS_NODE_UNITY_ENABLED=0
ATLAS_UNITY_CLI=
ATLAS_UNITY_ALLOWED_COMMANDS=

# macOS login-session receiver only. Must also approve directional peer pairs
# on Atlas Server. Shows explicit user confirmation before writing clipboard.
ATLAS_NODE_SHARE_RECEIVE_ENABLED=false

# Off by default. Enables encrypted, bounded local file delivery on reconnect.
# Atlas Server must independently enable ATLAS_NODE_FILES_ENABLED for uploads.
ATLAS_NODE_FILE_QUEUE_ENABLED=0
