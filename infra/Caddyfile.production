{$ATLAS_SITE_ADDRESS} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }

    route {
        # Atlas Nodes authenticate themselves with a Server-issued Bearer credential.
        # Keep these routes outside the human-facing Basic Auth layer.
        @node path /node/connect /node/enrol /node/files/upload /node/files/resumable/* /node/update-intents/claim /node/update-intents/report
        reverse_proxy @node server:3000 {
            # Atlas is always externally HTTPS: after cutover it receives
            # HTTP from the standalone proxy over a private Docker bridge.
            header_up X-Forwarded-Proto https
        }

        # Explicitly public portfolio delivery endpoints. The Contentful webhook has
        # its own signature verification inside Atlas Server.
        @public path /api/public/portfolio /api/media/* /integrations/contentful/webhook
        reverse_proxy @public server:3000 {
            # Atlas is always externally HTTPS: after cutover it receives
            # HTTP from the standalone proxy over a private Docker bridge.
            header_up X-Forwarded-Proto https
        }

        # ChatGPT connects directly to streamable HTTP MCP using OAuth.
        # The Server validates JWT audience, signature, scopes and owner subject.
        # If OAuth is unset, hosted /mcp returns 503 (never anonymous access).
        @mcp path /mcp /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp
        reverse_proxy @mcp server:3000 {
            # Atlas is always externally HTTPS: after cutover it receives
            # HTTP from the standalone proxy over a private Docker bridge.
            header_up X-Forwarded-Proto https
        }

        # Temporary private human UI/API boundary, independent of MCP OAuth.
        basic_auth {
            {$VPS_ADMIN_USER} {$VPS_ADMIN_PASSWORD_HASH}
        }

        @backend path /api/* /mcp /projects/* /health
        reverse_proxy @backend server:3000 {
            # Atlas is always externally HTTPS: after cutover it receives
            # HTTP from the standalone proxy over a private Docker bridge.
            header_up X-Forwarded-Proto https
        }

        try_files {path} /index.html
        file_server
    }
}
