# Copy this file to infra/production.env. Never commit the real file.
#
# Do not expose Atlas Web/API or Node credentials over plain HTTP. Until a
# hostname has working HTTPS, start only postgres + server and reach Server via
# the VPS loopback port through an SSH tunnel.
#
# Once DNS points a hostname at the VPS:
#   ATLAS_SITE_ADDRESS=atlas.example.com
#   ATLAS_WORKSPACE_ORIGINS=https://atlas.example.com
#
# Local development origins may be kept alongside the production origin.

ATLAS_SITE_ADDRESS=atlas.example.com
ATLAS_WORKSPACE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://atlas.example.com

# Protects Atlas Web, /api, /mcp, /projects and /health at the Caddy edge.
ATLAS_ADMIN_USER=atlas
# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
# Keep the hash single-quoted so '$' characters remain literal.
ATLAS_ADMIN_PASSWORD_HASH='$2a$14$REPLACE_ME'

# Generate a URL-safe value, e.g.:
#   openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql://atlas:REPLACE_WITH_THE_SAME_RANDOM_HEX@postgres:5432/atlas

# Optional. Atlas falls back to lexical retrieval if the Ollama embedding endpoint
# is unavailable; Ask Atlas itself still requires a configured generation provider.
OLLAMA_URL=http://127.0.0.1:11434
FABRIC_EMBEDDING_MODEL=nomic-embed-text

# Optional Contentful integration.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=
CONTENTFUL_DELIVERY_ACCESS_TOKEN=
CONTENTFUL_WEBHOOK_SIGNING_SECRET=
CONTENTFUL_WEBHOOK_TTL_SECONDS=
