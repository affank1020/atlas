# Copy this file to infra/production.env. Never commit the real file.
#
# Do not expose Atlas Web/API or Node credentials over plain HTTP. Until a
# hostname has working HTTPS, start only postgres + server and reach Server via
# the VPS loopback port through an SSH tunnel.
#
# Once DNS points a hostname at the VPS:
#   ATLAS_SITE_ADDRESS=atlas.example.com
#   ATLAS_WORKSPACE_ORIGINS=https://atlas.example.com
#
# Local development origins may be kept alongside the production origin.

ATLAS_SITE_ADDRESS=atlas.example.com
ATLAS_WORKSPACE_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://atlas.example.com

# Direct ChatGPT MCP OAuth (configure all three with a trusted identity provider).
# Without these, hosted /mcp returns 503; it is NEVER anonymously accessible.
# Create an Auth0 API with the exact audience/resource below, and permission
# atlas:access. Use the issuer domain ending in / and the exact Auth0 user_id.
# Configure Resource Parameter Compatibility Profile in Auth0.
# ATLAS_MCP_RESOURCE=https://atlas.example.com/mcp
# ATLAS_MCP_OAUTH_ISSUER=https://YOUR_TENANT.REGION.auth0.com/
# ATLAS_MCP_OAUTH_ALLOWED_SUBJECT=auth0|YOUR_AUTH0_USER_ID
ATLAS_MCP_RESOURCE=
ATLAS_MCP_OAUTH_ISSUER=
ATLAS_MCP_OAUTH_ALLOWED_SUBJECT=
# Optional dedicated Relay MCP service token: hash of "openssl rand -hex 32" output.
# Only the SHA-256 digest belongs in Atlas; the raw token lives in Relay's private .env.
# Relay's service identity is read-only; Auth0 for ChatGPT is unchanged.
ATLAS_MCP_RELAY_TOKEN_SHA256=
# Separate opt-in Relay coding credential and root checkout UUIDs (no wildcard).
# The existing Relay read-only token never gains write authority.
ATLAS_MCP_RELAY_CODING_TOKEN_SHA256=
ATLAS_MCP_RELAY_CODING_CHECKOUTS=
# Temporarily enable credential-free MCP stage logs during incident diagnosis.
ATLAS_MCP_DIAGNOSTICS=false

# Protects Atlas Web, /api, /projects and /health at the Caddy edge.
# /mcp is separately protected by OAuth token verification in Atlas Server.
ATLAS_ADMIN_USER=atlas
# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
# Keep the hash single-quoted so '$' characters remain literal.
ATLAS_ADMIN_PASSWORD_HASH='$2a$14$REPLACE_ME'

# Generate a URL-safe value, e.g.:
#   openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql://atlas:REPLACE_WITH_THE_SAME_RANDOM_HEX@postgres:5432/atlas

# Optional. Atlas falls back to lexical retrieval if the Ollama embedding endpoint
# is unavailable; Ask Atlas itself still requires a configured generation provider.
OLLAMA_URL=http://127.0.0.1:11434
FABRIC_EMBEDDING_MODEL=nomic-embed-text

# Phase 4.3 — optional GitHub App broker (DENY by default).
# Install a GitHub App only on an approved repository, with Contents:write
# and Pull requests:write. Do not publish this file with real values.
# Supply a PEM private key as a single escaped-newline value ("\\n" sequences);
# prefer single-quoted .env values to avoid Compose interpolation.
# GitHub App key stays on the SERVER; do not put it in /etc/atlas-node/node.env.
ATLAS_GITHUB_APP_ID=
ATLAS_GITHUB_INSTALLATION_ID=
ATLAS_GITHUB_APP_PRIVATE_KEY_PEM=
# Exact Workspace UUID -> GitHub repository mapping, as single-quoted JSON:
# ATLAS_GITHUB_WORKSPACE_REPOSITORIES='{"b0642889-d2b4-41de-bf22-c3ef2ef334bb":"affank1020/portfolio-site"}'
ATLAS_GITHUB_WORKSPACE_REPOSITORIES=

# Optional repository-specific trusted publishers for historical Code Reviewer imports.
# Use the GitHub numeric user IDs verified for each repository; do not trust a
# Markdown review heading or user login alone. Imports are disabled if unset.
# Example: ATLAS_CODE_REVIEW_TRUSTED_PUBLISHERS_JSON='{"affank1020/atlas":[58519561]}'
ATLAS_CODE_REVIEW_TRUSTED_PUBLISHERS_JSON=

# Explicit opt-in only after independent review of the GitHub publisher.
# Example: ATLAS_CODE_REVIEW_PUBLISH_REPOSITORIES=affank1020/atlas
# Empty means no repository may publish; never authorizes APPROVE.
ATLAS_CODE_REVIEW_PUBLISH_REPOSITORIES=

# Global opt-in for managed summaries, initial inline threads, follow-up replies
# and fix-evidence replies on ALL repositories available to the GitHub App.
# The legacy COMMENT publisher above must be EMPTY across all repositories.
# Still requires per-repository GitHub App write permission, verified OAuth,
# current PR head, single publisher and explicit apply:true.
# Does NOT authorize PR approval/merges, GraphQL resolution or automatic posting.
ATLAS_CODE_REVIEW_PUBLISH_ALL_REPOSITORIES=false

# Native Atlas-managed GitHub PR summary and inline conversation publishers.
# Enable on explicitly approved repositories only after verifying the single
# publishing authority, current deployed image, Code Reviewer skill routing,
# and GitHub App Pull requests:write permissions. Keep the legacy flag above
# EMPTY for any repository enabled below.
# Example (after acceptance): ATLAS_CODE_REVIEW_MANAGED_SUMMARY_REPOSITORIES=affank1020/atlas
ATLAS_CODE_REVIEW_MANAGED_SUMMARY_REPOSITORIES=
ATLAS_CODE_REVIEW_INLINE_ROOT_REPOSITORIES=
ATLAS_CODE_REVIEW_INLINE_REPLY_REPOSITORIES=
ATLAS_CODE_REVIEW_INLINE_FIX_REPOSITORIES=

# Independent high-privilege option for GitHub GraphQL review-thread resolution.
# Do NOT enable for the ordinary review-comment cutover; resolution also needs
# Contents:write and Pull requests:write, verified live.
ATLAS_CODE_REVIEW_RESOLVE_THREAD_REPOSITORIES=

# Opt-in Node-authenticated HTTP uploads (default OFF).
# Turn on only after R2/backup verification and security review.
# No Caddy Basic Auth is used; Nodes use their own credentials.
ATLAS_NODE_FILES_ENABLED=false

# Optional Cloudflare R2 object storage. Leave all four empty for local media.
# Optional image-sharing directional allowlist, independent from text approval.
# Format: sourceAndroidUUID:targetMacUUID[,sourceUUID:targetUUID].
# Empty disables all binary image handoffs. Set only after an explicit grant.
ATLAS_DEVICE_IMAGE_PAIRS=

# Keep atlas_media mounted for pre-migration files.
# Actual credentials belong only in the VPS's private production.env.
ATLAS_R2_ENDPOINT=
ATLAS_R2_BUCKET=
ATLAS_R2_ACCESS_KEY_ID=
ATLAS_R2_SECRET_ACCESS_KEY=

# Disabled until the operator has finished existing Project/Portfolio key
# migration. Then write new Project Files and Portfolio originals/variants
# under projects/<project-uuid>/objects/<file-uuid>/v1.
# Requires the four primary R2 settings. Legacy Workspace/Node uploads and
# existing flat-key downloads remain supported. Do not set this ahead of the
# immutable old-key copy run: newly versioned source rows cannot be captured
# by the legacy-source migration ledger.
ATLAS_PROJECT_VERSIONED_WRITES_ENABLED=false

# Optional Data page usage metrics, separate from R2 S3 access credentials.
# Create a Cloudflare API token scoped to Account > Account Analytics > Read.
# The token and account ID stay server-side. An unset pair displays "not connected".
ATLAS_CF_ACCOUNT_ID=
ATLAS_CF_ANALYTICS_TOKEN=

# Optional Contentful integration.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=
CONTENTFUL_DELIVERY_ACCESS_TOKEN=
CONTENTFUL_WEBHOOK_SIGNING_SECRET=
CONTENTFUL_WEBHOOK_TTL_SECONDS=
