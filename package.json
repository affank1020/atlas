{
  "name": "atlas-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @atlas/server",
    "dev:node": "npm run dev -w @atlas/node",
    "dev:web": "npm run dev -w @atlas/web",
    "start:server": "npm run start -w @atlas/server",
    "start:node": "npm run start -w @atlas/node",
    "build:protocol": "npm run build -w @atlas/protocol",
    "build:server": "npm run build:protocol && npm run build:views && npm run build -w @atlas/server",
    "build:node": "npm run build:protocol && npm run build -w @atlas/node",
    "build:web": "npm run build:views && npm run build -w @atlas/web",
    "build": "npm run build:protocol && npm run build:views && npm run build -w @atlas/server && npm run build -w @atlas/node && npm run build -w @atlas/web",
    "test:server": "npm run build:server && node --import tsx --test test/*.test.ts",
    "test:node": "npm run build:node && node --import tsx --test test/remote-node.test.ts test/node-identity.test.ts test/workspace-dev.test.ts test/workspaces.test.ts",
    "test:web": "npm run test -w @atlas/web",
    "test": "npm run build && node --import tsx --test test/*.test.ts && npm run test:web && npm run test:mac-ui",
    "test:mac-ui": "bash scripts/build-node-ui.sh --check",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:status": "node scripts/db.mjs status",
    "files:audit": "node apps/server/dist/server/files-audit-cli.js --dry-run",
    "files:r2:verify-recovery": "node apps/server/dist/server/r2-recovery-cli.js --dry-run",
    "files:r2:verify-catalog": "node apps/server/dist/server/r2-recovery-catalog-cli.js --dry-run",
    "files:r2:seed": "node apps/server/dist/server/r2-backup-seed-cli.js",
    "files:r2:project-key-copy": "node apps/server/dist/server/project-key-copy-cli.js",
    "files:r2:project-checkpoint": "node apps/server/dist/server/project-key-ledger-cli.js",
    "files:r2:project-recovery": "node apps/server/dist/server/project-recovery-cli.js",
    "files:r2:isolated-legacy-files": "node apps/server/dist/server/isolated-legacy-files-cli.js",
    "files:r2:isolated-recovery-coverage": "node apps/server/dist/server/isolated-recovery-coverage-cli.js",
    "files:r2:project-cutover-check": "node apps/server/dist/server/project-cutover-cli.js",
    "files:r2:project-cutover-rehearsal": "node apps/server/dist/server/project-cutover-rehearsal-cli.js",
    "files:staging:maintenance": "node apps/server/dist/server/node-transfer-maintenance-cli.js",
    "files:node:enqueue": "node apps/node/dist/core/file-queue-cli.js enqueue",
    "files:node:queue-status": "node apps/node/dist/core/file-queue-cli.js status",
    "files:node:queue-restart": "node apps/node/dist/core/file-queue-cli.js restart-new",
    "files:node:queue-discard": "node apps/node/dist/core/file-queue-cli.js discard",
    "workspace:register-atlas": "node scripts/register-atlas-workspace.mjs",
    "verify:remote-node": "node --import tsx scripts/verify-remote-node.mjs",
    "build:views": "npm run build -w @atlas/view-runtime",
    "verify:workspace": "node --import tsx scripts/workspace-live-verify.mjs",
    "test:benchmark": "node scripts/benchmark-ci.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@atlas/protocol": "2.0.0",
    "@atlas/server": "2.0.0",
    "@atlas/node": "2.0.0",
    "pg": "^8.23.0",
    "dotenv": "^17.4.2"
  }
}
