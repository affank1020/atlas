{
  "name": "atlas-mcp-poc",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Atlas structured data platform exposed through MCP",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:status": "node scripts/db.mjs status",
    "db:import-json": "node scripts/import-json.mjs",
    "fabric:configure-authority": "node scripts/configure-authority.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@contentful/node-apps-toolkit": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dotenv": "^17.4.2",
    "handlebars": "^4.7.9",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
